# ==========================================
# CONFIGURACIÓN DE ENTORNO - SPLITWISE SENA
# ==========================================

# Puerto de ejecución del servidor
PORT=5000

# Entorno de ejecución: development | production
NODE_ENV=development

# URI de Conexión a MongoDB Atlas (Opcional)
# Si lo dejas vacío o no existe, la app usará automáticamente la persistencia local en data/db.json
# Ejemplo MongoDB Atlas:
# MONGODB_URI=mongodb+srv://usuario:password@cluster0.abcde.mongodb.net/splitwise_sena?retryWrites=true&w=majority
MONGODB_URI=

# Origen CORS permitido
CORS_ORIGIN=*

# Moneda por defecto
DEFAULT_CURRENCY=COP
